# Copia este archivo a .env y rellénalo con tus valores reales.
# connect-it es AHORA el único proyecto de Supabase, compartido con el
# panel de administración — no crear un proyecto nuevo para la app móvil.
EXPO_PUBLIC_SUPABASE_URL=https://cucvqfhucmjphjpquivn.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Client IDs de Google Cloud Console (proyecto connect-it-507702, el mismo
# que ya usa el panel admin) — hay que crear un Client ID de tipo "iOS" y
# otro de tipo "Android" específicos para esta app móvil, y añadirlos como
# "Authorized Client IDs" en Supabase Dashboard > Authentication > Providers
# > Google (además del que ya está puesto ahí para el panel admin/web).
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
